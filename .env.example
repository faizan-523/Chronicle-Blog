# PostgreSQL Database connection string
DATABASE_URL="postgresql://username:password@localhost:5432/blog_db?schema=public"

# JWT secret key for signing tokens (change this to a secure random string in production)
JWT_SECRET="your_super_secret_jwt_key_change_this"

# Base URL for server-side fetch calls to own API routes
NEXT_PUBLIC_APP_URL="http://localhost:3000"
